{
    "name": "chenjia404/dcat-admin",
    "description": "dcat admin",
    "type": "library",
    "keywords": [
        "dcat",
        "laravel",
        "admin",
        "grid",
        "form",
        "laravel admin"
    ],
    "homepage": "https://github.com/chenjia404/dcat-admin",
    "license": "MIT",
    "authors": [
        {
            "name": "jqh",
            "email": "841324345@qq.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "~11.0|~12.0|~13.0",
        "spatie/eloquent-sortable": "^5.0",
        "doctrine/dbal": "^3.8|^4.0",
        "openspout/openspout": "^4.28"
    },
    "require-dev": {
        "laravel/dusk": "^8.6",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^10.5|^11.0|^12.0",
        "fakerphp/faker": "^1.24",
        "mockery/mockery": "^1.6.12"
    },
    "autoload": {
        "psr-4": {
            "Dcat\\Admin\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Dcat\\Admin\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dcat\\Admin\\AdminServiceProvider"
            ]
        }
    }
}
